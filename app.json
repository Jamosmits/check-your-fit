{
  "expo": {
    "name": "Check Your Fit",
    "slug": "check-your-fit",
    "version": "1.0.0",
    "scheme": "checkyourfit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.checkyourfit.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F7F5"
      },
      "package": "com.checkyourfit.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Check Your Fit to access your camera to scan clothing items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Check Your Fit to access your photos to add clothing items."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Check Your Fit to access your location for weather-based outfit suggestions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2C2C2C"
        }
      ]
    ]
  }
}
